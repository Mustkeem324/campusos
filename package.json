{
  "name": "campusos-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-service-env.mjs next dev apps/web --port 3000 --webpack",
    "verify:prisma-toolchain": "node scripts/verify-prisma-toolchain.mjs",
    "prebuild": "npm run verify:prisma-toolchain && node scripts/run-with-service-env.mjs prisma generate --schema=packages/db/prisma/schema.prisma && node scripts/run-with-service-env.mjs node scripts/prepare-database.mjs",
    "build": "node scripts/run-with-service-env.mjs next build apps/web --webpack && node scripts/verify-next-output.mjs",
    "start": "node scripts/run-with-service-env.mjs next start apps/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "db:generate": "npm run verify:prisma-toolchain && node scripts/run-with-service-env.mjs prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:prepare": "node scripts/run-with-service-env.mjs node scripts/prepare-database.mjs",
    "db:reset-synthetic": "node scripts/run-with-service-env.mjs node scripts/reset-synthetic-campus.mjs --allow-synthetic-seed",
    "db:seed-synthetic": "npm run db:reset-synthetic && node scripts/run-with-service-env.mjs node scripts/seed-synthetic-campus.mjs --allow-synthetic-seed",
    "db:seed-synthetic:reset": "npm run db:seed-synthetic",
    "db:verify-synthetic": "node scripts/run-with-service-env.mjs node scripts/verify-synthetic-campus.mjs",
    "db:bootstrap-demo": "npm run db:seed-synthetic:reset",
    "db:migrate": "node scripts/run-with-service-env.mjs prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "seed:demo": "npm run db:seed-synthetic",
    "seed:demo:reset": "npm run db:seed-synthetic:reset",
    "seed:demo:validate": "node scripts/run-with-service-env.mjs npx tsx apps/web/scripts/demo-seed/index.ts --validate-only",
    "seed:demo:small": "node scripts/run-with-service-env.mjs npx tsx apps/web/scripts/demo-seed/index.ts --students=20 --faculty=8 --courses=12 --seed=1001 --reset",
    "seed:demo:default": "npm run db:seed-synthetic:reset",
    "seed:demo:large": "node scripts/run-with-service-env.mjs npx tsx apps/web/scripts/demo-seed/index.ts --students=1000 --faculty=100 --courses=100 --seed=5001 --reset",
    "perf:seed-million-attendance": "node scripts/performance/seed-million-attendance.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.453.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
