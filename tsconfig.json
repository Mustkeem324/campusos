{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "es2017"
  },
  "include": ["vitest.config.ts", "wait_for_build.js", "generate_routes.js"],
  "exclude": ["node_modules"]
}
