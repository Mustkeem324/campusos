# Local Docker service ports
# Docker Compose reads these values when a local .env is present. The dedicated
# `dev:local` and `db:seed-synthetic:local` commands use the same defaults and
# intentionally override stale hosted service URLs for their child processes.
CAMPUSOS_POSTGRES_HOST_PORT="5433"
CAMPUSOS_REDIS_HOST_PORT="6380"
CAMPUSOS_MINIO_API_PORT="9000"
CAMPUSOS_MINIO_CONSOLE_PORT="9001"
CAMPUSOS_MAILHOG_SMTP_PORT="1025"
CAMPUSOS_MAILHOG_UI_PORT="8025"

# Database
# Canonical technical variable. This always takes priority for normal commands.
# Local Docker Compose exposes PostgreSQL on host port 5433 (container port 5432).
# For deterministic local setup use: npm run dev:local
DATABASE_URL="postgresql://campusos:campusos_password@localhost:5433/campusos_db?schema=public"

# Vercel integration aliases are also supported by the application and build scripts:
# campusos_DATABASE_URL
# CAMPUSOS_DATABASE_URL
# campusos_POSTGRES_URL
# CAMPUSOS_POSTGRES_URL
# campusos_PRISMA_DATABASE_URL
# CAMPUSOS_PRISMA_DATABASE_URL
#
# Important: never copy a hosted/production DATABASE_URL into local development unless
# that database is intentionally reachable from the development machine. To seed the
# local Docker database regardless of a stale hosted URL, use:
#   npm run db:seed-synthetic:local

# Database deployment controls
# Set explicitly only when schema synchronization should run during deployment.
CAMPUSOS_AUTO_DB_PUSH="false"
# Development/QA only. Deployments never seed synthetic institutions unless this is explicitly true.
CAMPUSOS_AUTO_SEED_SYNTHETIC="false"

# Redis Cache & Queue
# Local Docker Redis intentionally uses host port 6380 to avoid colliding with a
# system Redis that commonly occupies 6379. Container Redis still listens on 6379.
REDIS_URL="redis://localhost:6380"
# Vercel alias also supported: campusos_REDIS_URL

# Auth Secrets
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Official result verification
# Dedicated HMAC secret used to sign public result-verification tokens. Use at
# least 32 random characters and keep it stable so previously issued QR codes
# continue to verify. JWT_SECRET is used as a compatibility fallback.
RESULT_VERIFICATION_SECRET="replace-with-a-stable-result-verification-secret"

# Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET="campusos-documents"
S3_REGION="us-east-1"

# Public application origin
# Trusted absolute origin used when constructing hosted payment return URLs.
# Production example: https://navemora.example.com
APP_PUBLIC_URL="http://localhost:3000"

# Payment gateways
# Razorpay: create live/test API keys in the Razorpay dashboard. The webhook
# endpoint for payment.captured events is:
#   https://YOUR_DOMAIN/api/payments/webhooks/razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe: use the server secret key here. Configure a webhook for
# checkout.session.completed at:
#   https://YOUR_DOMAIN/api/payments/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email SMTP
# Local MailHog example: host localhost, port 1025, no SMTP_USER/SMTP_PASS required.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="noreply@navemora.local"
CONTACT_TO_EMAIL="contact@navemora.local"
# Production SMTP providers normally require credentials:
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# Optional explicit sender override supported by the public contact endpoint:
# SMTP_FROM_EMAIL="NAVEMORA <noreply@example.com>"

# AI Student Help
# OpenAI-compatible chat-completions endpoint or an institution-controlled AI gateway.
# Production endpoints must use HTTPS. Localhost/127.0.0.1 HTTP is accepted for development only.
CAMPUSOS_AI_CHAT_ENDPOINT=""
CAMPUSOS_AI_MODEL=""
# Optional when an internal/local gateway does not require bearer authentication.
CAMPUSOS_AI_API_KEY=""

# Environment
# NODE_ENV is set by the toolchain (next dev / next build). Setting it in a .env file
# makes every production build run in a broken mixed mode, so it must never be set here.
PORT=3000
