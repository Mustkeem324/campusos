# Local Docker service ports
# Docker Compose reads these values when a local .env is present. The dedicated
# `dev:local` and `db:seed-synthetic:local` commands use the same defaults and
# intentionally override stale hosted service URLs for their child processes.
CAMPUSOS_POSTGRES_HOST_PORT="5433"
CAMPUSOS_REDIS_HOST_PORT="6380"
CAMPUSOS_MINIO_API_PORT="9000"
CAMPUSOS_MINIO_CONSOLE_PORT="9001"
CAMPUSOS_MAILHOG_SMTP_PORT="1025"
CAMPUSOS_MAILHOG_UI_PORT="8025"

# Database
DATABASE_URL="postgresql://campusos:campusos_password@localhost:5433/campusos_db?schema=public"
# Vercel aliases also supported: campusos_DATABASE_URL, CAMPUSOS_DATABASE_URL,
# campusos_POSTGRES_URL, CAMPUSOS_POSTGRES_URL, campusos_PRISMA_DATABASE_URL,
# CAMPUSOS_PRISMA_DATABASE_URL.
CAMPUSOS_AUTO_DB_PUSH="false"
CAMPUSOS_AUTO_SEED_SYNTHETIC="false"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6380"

# Auth Secrets
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Official result verification
RESULT_VERIFICATION_SECRET="replace-with-a-stable-result-verification-secret"

# Secure Examination identity verification
NAVEMORA_EXAM_ID_VERIFY_URL=""
NAVEMORA_EXAM_ID_VERIFY_SECRET=""

# Secure Examination realtime WebRTC media
NAVEMORA_EXAM_MEDIA_PUBLIC_URL="http://localhost:8889"
NAVEMORA_EXAM_MEDIA_INTERNAL_URL="http://mediamtx:8889"
NAVEMORA_EXAM_MEDIA_TOKEN_SECRET="replace-with-at-least-32-random-characters"
NAVEMORA_EXAM_MEDIA_AUTH_URL="http://host.docker.internal:3000/api/examinations/proctoring/runtime/media-auth"
NAVEMORA_EXAM_MEDIA_ALLOWED_ORIGINS="http://localhost:3000"
NAVEMORA_EXAM_MEDIA_ADDITIONAL_HOSTS=""
NAVEMORA_EXAM_MEDIA_HTTP_PORT="8889"
NAVEMORA_EXAM_MEDIA_ICE_PORT="8189"
NAVEMORA_EXAM_VISION_MEDIA_SECRET="replace-with-a-different-32-character-secret"
NAVEMORA_EXAM_VISION_INFER_URL=""
NAVEMORA_EXAM_VISION_INFER_SECRET=""
NAVEMORA_EXAM_VISION_POLL_MS="3000"
NAVEMORA_EXAM_VISION_WORKER_ID=""

# Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET="campusos-documents"
S3_REGION="us-east-1"

# Public application origin
APP_PUBLIC_URL="http://localhost:3000"

# Payment gateways
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Legacy/general SMTP configuration used by existing contact surfaces.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="noreply@navemora.local"
CONTACT_TO_EMAIL="contact@navemora.local"
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# SMTP_FROM_EMAIL="NAVEMORA <noreply@example.com>"

# -----------------------------------------------------------------------------
# NAVEMORA Omnichannel Communications, Email, SMS & WhatsApp 2.0
# -----------------------------------------------------------------------------
# Development is fail-safe: email goes to MailHog and SMS/WhatsApp go to local
# test sinks. Set `live` only in an intentionally configured production runtime.
CAMPUSOS_COMMUNICATION_MODE="development"
NAVEMORA_COMMUNICATION_WORKER_CONCURRENCY="5"
NAVEMORA_COMMUNICATION_WORKER_POLL_MS="1500"
NAVEMORA_COMMUNICATION_WORKER_ID=""

# Trusted server-to-server event ingestion. Use at least 32 random characters.
# Never expose this or any provider credential through NEXT_PUBLIC_* variables.
NAVEMORA_COMMUNICATION_INTERNAL_SECRET="replace-with-at-least-32-random-characters"
# Generic provider webhook HMAC secret; provider-specific signatures are used
# for Meta/Twilio when their dedicated credentials are configured.
NAVEMORA_COMMUNICATION_WEBHOOK_SECRET="replace-with-a-different-32-character-secret"
NAVEMORA_COMMUNICATION_STATUS_CALLBACK_URL=""

# Email provider abstraction: SMTP | RESEND | SENDGRID | POSTMARK | CUSTOM.
# In development SMTP defaults to MailHog on localhost:1025.
NAVEMORA_EMAIL_PROVIDER="SMTP"
NAVEMORA_EMAIL_FROM="NAVEMORA <noreply@navemora.local>"
NAVEMORA_EMAIL_REPLY_TO=""
NAVEMORA_SMTP_HOST="localhost"
NAVEMORA_SMTP_PORT="1025"
NAVEMORA_SMTP_SECURE="false"
NAVEMORA_SMTP_USER=""
NAVEMORA_SMTP_PASSWORD=""
NAVEMORA_RESEND_API_KEY=""
NAVEMORA_SENDGRID_API_KEY=""
NAVEMORA_POSTMARK_SERVER_TOKEN=""

# SMS provider abstraction. Paid SMS remains institution-disabled until an
# active channel subscription/credit policy exists in campusos_communications.
# Supported first-party adapters: TWILIO, MSG91, plus CUSTOM HTTP provider.
NAVEMORA_SMS_PROVIDER=""
NAVEMORA_SMS_API_KEY=""
NAVEMORA_SMS_API_SECRET=""
NAVEMORA_SMS_FROM=""
NAVEMORA_TWILIO_ACCOUNT_SID=""
NAVEMORA_TWILIO_AUTH_TOKEN=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
# Regulatory sender/header/entity/template identifiers belong to institution
# provider configuration; no regulatory identifier is hardcoded by NAVEMORA.

# WhatsApp Business provider abstraction: META_WHATSAPP | TWILIO | CUSTOM.
# Production Meta delivery requires provider-approved template mappings.
NAVEMORA_WHATSAPP_PROVIDER=""
NAVEMORA_WHATSAPP_ACCESS_TOKEN=""
NAVEMORA_WHATSAPP_PHONE_NUMBER_ID=""
NAVEMORA_WHATSAPP_APP_SECRET=""
NAVEMORA_WHATSAPP_VERIFY_TOKEN=""
NAVEMORA_WHATSAPP_FROM=""
TWILIO_WHATSAPP_FROM=""

# Optional custom outbound provider gateway for institution/platform adapters.
NAVEMORA_COMMUNICATION_CUSTOM_PROVIDER_URL=""
NAVEMORA_COMMUNICATION_CUSTOM_PROVIDER_SECRET=""

# AI Student Help
CAMPUSOS_AI_CHAT_ENDPOINT=""
CAMPUSOS_AI_MODEL=""
CAMPUSOS_AI_API_KEY=""

# Environment
# NODE_ENV is set by the toolchain. Do not put NODE_ENV in .env.
PORT=3000
