# Database
# Canonical CampusOS variable. This always takes priority.
DATABASE_URL="postgresql://campusos:campusos_password@localhost:5432/campusos_db?schema=public"

# Vercel integration aliases are also supported by the application and build scripts:
# campusos_DATABASE_URL
# campusos_POSTGRES_URL
# campusos_PRISMA_DATABASE_URL
# Uppercase CAMPUSOS_* variants are supported as well.

# Database deployment controls
# Set explicitly only when schema synchronization should run during deployment.
CAMPUSOS_AUTO_DB_PUSH="false"
# Development/QA only. Deployments never seed synthetic institutions unless this is explicitly true.
CAMPUSOS_AUTO_SEED_SYNTHETIC="false"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"
# Vercel alias also supported: campusos_REDIS_URL

# Auth Secrets
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET="campusos-documents"
S3_REGION="us-east-1"

# Payment gateways
# Razorpay: create live/test API keys in the Razorpay dashboard. The webhook
# endpoint for payment.captured events is:
#   https://YOUR_DOMAIN/api/payments/webhooks/razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe: use the server secret key here. Configure a webhook for
# checkout.session.completed at:
#   https://YOUR_DOMAIN/api/payments/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email SMTP
# Local MailHog example: host localhost, port 1025, no SMTP_USER/SMTP_PASS required.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="noreply@campusos.local"
CONTACT_TO_EMAIL="contact@campusos.local"
# Production SMTP providers normally require credentials:
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# Optional explicit sender override supported by the public contact endpoint:
# SMTP_FROM_EMAIL="CampusOS <noreply@example.com>"

# Environment
NODE_ENV="development"
PORT=3000
